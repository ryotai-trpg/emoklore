      },
      "autoArmorReduction": {
        "Name": "装備中の防具を自動で引く",
        "Hint": "ダメージ適用のとき、装備している防具の防御力を自動で軽減に加えます。切ると防具は「軽減して適用」ダイアログで自分で選ぶことになります（怪異の装甲はこの設定に関わらず常に効きます）。"
      },
      "autoHpBoundaryNotice": {
        "Name": "HPの境界を案内する",
        "Hint": "一度に半分以上を失ったときと、HPが0になったときに、状態を付けるボタン付きの案内をチャットに出します。判定の強制や状態の自動付与はどちらの設定でも行いません。"
      },
      "autoMpBoundaryNotice": {
        "Name": "MPの境界を案内する",
        "Hint": "MPが0以下にまたいだときに、【失神】を付けるボタン付きの案内をチャットに出します。"
      },
      "autoSurvivalReminder": {
        "Name": "〈＊生存〉判定を促す",
