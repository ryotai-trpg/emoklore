{
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@types/node": "^26.2.0",
    "handlebars": "^4.7.9",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "npm run build:packs && vite build",
    "build:packs": "node tools/build-packs.mjs",
    "dev": "npm run build && vite dev",
    "watch": "npm run build:packs && vite build --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "prepare": "lefthook install",
    "check:biome-version": "node tools/check-biome-version.mjs",
    "check:lang": "node tools/check-lang.mjs",
    "check:i18n": "node tools/check-i18n.mjs",
    "check:templates": "node tools/check-templates.mjs",
    "check:schema-doc": "node tools/check-schema-doc.mjs",
    "check:manifest-urls": "node tools/check-manifest-urls.mjs",
    "check:layers": "node tools/check-layers.mjs",
    "check:roadmap": "node tools/check-roadmap.mjs",
    "check:issue-refs": "node tools/check-issue-refs.mjs",
    "check:wiring": "node tools/check-wiring.mjs",
    "check:css": "node tools/check-css.mjs",
    "link:foundry": "node tools/create-symlinks.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "verify:live": "node tests/live/run.mjs",
    "shots:live": "node tests/live/shots.mjs"
  }
}
