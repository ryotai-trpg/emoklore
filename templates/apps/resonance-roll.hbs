{{! 本体の standard-form 体系に乗せる。name 属性は resonance-roll-dialog.ts が
    form.elements.namedItem で引くインターフェースなので変えない }}
<div class="form-group">
  <label for="intensity">{{localize "EMOKLORE.Resonance.Intensity"}}</label>
  <input name="intensity" id="intensity" type="number" placeholder="1" min="1" max="9" autofocus>
</div>

<div class="form-group stacked">
  <div class="form-fields">
    <label><input type="radio" name="choice" value="none" checked> {{localize "EMOKLORE.Resonance.MatchNone"}}</label>
    <label><input type="radio" name="choice" value="root"> {{localize "EMOKLORE.Resonance.MatchRoot"}}</label>
    <label><input type="radio" name="choice" value="completely"> {{localize "EMOKLORE.Resonance.MatchCompletely"}}</label>
  </div>
</div>
