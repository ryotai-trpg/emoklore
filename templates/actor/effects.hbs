{{! Effects Tab }}
<section class="tab effects {{tab.cssClass}}" data-group="primary" data-tab="effects">
  {{! 追加取得した共鳴感情。共振や怪異の付与で後から増えるもので、3枠と違って件数に
      上限が無い。ヘッダに置くとヘッダの高さがこれで決まってしまうので、「後から受けた
      もの」を並べるこのタブが持つ。編集モードでなくても、権限があれば選び直せる }}
  {{! 1件も無いときは、選び直せる人にだけ空の枠を見せる（入口がここにあると分かる） }}
  {{#if (or editable acquiredEmotionRows.length)}}
    <section class="em-acquired">
      <header class="em-acquired__head">
        <h3 class="em-acquired__title">{{localize "EMOKLORE.EmotionPicker.AcquiredSection"}}</h3>
        {{#if editable}}
          <button type="button" class="em-acquired__pick" data-action="pickAcquiredEmotions">
            <i class="fa-solid fa-heart-circle-plus" inert></i>
            <span>{{localize "EMOKLORE.EmotionPicker.OpenAcquired"}}</span>
          </button>
        {{/if}}
      </header>
      {{#if acquiredEmotionRows.length}}
        <ul class="em-acquired__list">
          {{#each acquiredEmotionRows}}
            <li class="em-acquired__item">
              {{this.label}}
              {{#if this.attribute}}<span class="em-acquired__attribute">{{localize "EMOKLORE.Format.emotionAttribute" attribute=this.attribute}}</span>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="hint">{{localize "EMOKLORE.EmotionPicker.NoAcquired"}}</p>
      {{/if}}
    </section>
  {{/if}}

  <ol class="em-data-table">
    {{! ハウリング反応はアイテムそのものを並べる。反応が持つ効果は下の区分から除いてあり、
        「いま何を受けているか」を1件1行で見せる。受けていなければ区分ごと出さない }}
    {{#if howlings.length}}
      <li class="em-data-table__section" data-effect-type="howling">
        <div class="em-data-table__head">
          <div class="em-data-table__name">{{localize "EMOKLORE.Howling.Section"}}</div>
          <div class="em-data-table__cell">{{localize "EMOKLORE.Item.howling.FIELDS.category.label"}}</div>
          <div class="em-data-table__cell">{{localize "EMOKLORE.Item.howling.FIELDS.recovery.note.label"}}</div>
          <div class="em-data-table__controls"></div>
        </div>

        <ol class="em-data-table__body">
          {{#each howlings as |howling|}}
            <li
              class="em-data-table__row"
              data-item-id="{{howling.id}}"
              data-document-class="Item"
            >
              <div class="em-data-table__name">
                <img class="em-data-table__image" src="{{howling.img}}" height="24" width="24" />
                <div>{{howling.name}}</div>
              </div>
              <div class="em-data-table__cell">{{howling.categoryLabel}}</div>
              <div class="em-data-table__cell em-data-table__cell--wrap">
                {{! 判定で回復するものは技能ごとにショートカットを出す。押すと判定が飛ぶ }}
                {{#each howling.recoverySkills as |skill|}}
                  <a
                    data-action="roll"
                    data-roll-type="{{skill.rollType}}"
                    data-skill="{{skill.key}}"
                    data-tooltip="EMOKLORE.Howling.Recover"
                  >{{skill.label}}</a>
                {{/each}}
                {{#if howling.recoveryNote}}<span>{{howling.recoveryNote}}</span>{{/if}}
              </div>
              <div class="em-data-table__controls">
                <a
                  class="em-data-table__control"
                  data-action="viewDoc"
                  data-tooltip='{{localize "DOCUMENT.Update" type=""}}'
                >
                  <i class="fas fa-edit"></i>
                </a>
                {{#if @root.editable}}
                  {{! 回復＝反応そのものを消すこと。付いている効果もまとめて外れる }}
                  <a
                    class="em-data-table__control"
                    data-action="deleteDoc"
                    data-tooltip='{{localize "DOCUMENT.Delete" type=""}}'
                  >
                    <i class="fas fa-trash"></i>
                  </a>
                {{/if}}
              </div>
            </li>
          {{/each}}
        </ol>
      </li>
    {{/if}}

    {{#each effects as |section sid|}}
      {{! 区分ごとに1項目。見出しと明細のolを li の中に収める（ol直下にolは置けない） }}
      <li class="em-data-table__section" data-effect-type="{{section.type}}">
        <div class="em-data-table__head">
          <div class="em-data-table__name">{{section.label}}</div>
          <div class="em-data-table__cell">{{localize "EMOKLORE.Effect.Source"}}</div>
          <div class="em-data-table__cell">{{localize "EFFECT.TABS.duration"}}</div>
          <div class="em-data-table__controls">
            <a
              class="em-data-table__control"
              data-action="createDoc"
              data-document-class="ActiveEffect"
              data-origin="{{@root.document.uuid}}"
              data-img="icons/svg/aura.svg"
              {{#if (eq section.type "inactive")}}
                data-disabled="true"
              {{else if (eq section.type "temporary")}}
                {{! v14 の duration は {value, units} 。rounds/turns/seconds の直指定は
                    スキーマから消えており、data-duration.rounds では何も入らなかった }}
                data-duration.value="1"
                data-duration.units="rounds"
              {{/if}}
              data-tooltip='{{localize "DOCUMENT.Create" type=""}}'
            >
              <i class="fas fa-plus"></i>
            </a>
          </div>
        </div>

        <ol class="em-data-table__body">
          {{#each section.effects as |effect|}}
            <li
              class="em-data-table__row draggable"
              data-effect-id="{{effect.id}}"
              data-parent-id="{{effect.parent.id}}"
              data-document-class="ActiveEffect"
            >
              <div class="em-data-table__name">
                <img class="em-data-table__image" src="{{effect.img}}" height="24" width="24" />
                <div>{{effect.name}}</div>
              </div>
              <div class="em-data-table__cell">{{effect.sourceName}}</div>
              <div class="em-data-table__cell">{{effect.duration.label}}</div>
              <div class="em-data-table__controls">
                {{#if @root.editable}}
                  <a
                    class="em-data-table__control"
                    data-action="toggleEffect"
                    data-tooltip="EMOKLORE.Effect.Toggle"
                  >
                    <i class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}"></i>
                  </a>
                {{/if}}
                <a
                  class="em-data-table__control"
                  data-action="viewDoc"
                  data-tooltip='{{localize "DOCUMENT.Update" type=""}}'
                >
                  <i class="fas fa-edit"></i>
                </a>
                {{#if @root.editable}}
                  <a
                    class="em-data-table__control"
                    data-action="deleteDoc"
                    data-tooltip='{{localize "DOCUMENT.Delete" type=""}}'
                  >
                    <i class="fas fa-trash"></i>
                  </a>
                {{/if}}
              </div>
            </li>
          {{/each}}
        </ol>
      </li>
    {{/each}}
  </ol>
</section>
