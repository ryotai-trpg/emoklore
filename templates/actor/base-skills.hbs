{{! 基本技能。修得していなくても振れるので、閲覧モードにボタンで並べる }}
{{#if isPlay}}
<div class="em-chip-list">
  {{#each baseSkills as |baseSkill|}}
  <button
    type="button"
    class="em-chip"
    data-action="roll"
    data-roll-type="base-skill"
    data-skill="{{baseSkill.key}}"
  >
    {{baseSkill.label}} | {{baseSkill.target}}
    <i class="em-chip__icon fa-solid {{baseSkill.characteristicIcon}}"></i>
  </button>
  {{/each}}
</div>
{{/if}}
