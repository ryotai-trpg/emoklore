{{! 基本技能。修得していなくても振れるので、閲覧モードにボタンで並べる }}
{{#if isPlay}}
<div class="em-chip-list">
  {{#each baseSkills as |baseSkill|}}
  <button
    type="button"
    class="em-button em-button--inline em-button--wrap em-chip"
    data-action="roll"
    data-roll-type="base-skill"
    data-skill="{{baseSkill.key}}"
  >
    <span class="em-chip__name">{{baseSkill.markedLabel}}</span>
    <span class="em-target">{{baseSkill.target}}</span>
    <i class="fa-solid {{baseSkill.characteristicIcon}}"></i>
  </button>
  {{/each}}

  {{! ベース区分のカスタム技能も同じ列に並べる。組込と同じく修得の概念がないので、
      レベルによらず常に振れる }}
  {{#each customBaseSkills as |baseSkill|}}
  <button
    type="button"
    class="em-button em-button--inline em-button--wrap em-chip"
    data-action="roll"
    data-roll-type="custom-skill"
    data-item-id="{{baseSkill.id}}"
  >
    <span class="em-chip__name">{{baseSkill.markedLabel}}</span>
    <span class="em-target">{{baseSkill.target}}</span>
    <i class="fa-solid {{baseSkill.characteristicIcon}}"></i>
  </button>
  {{/each}}
</div>
{{/if}}
