{{! Human NPC sheet — 単一ルートが要る（HandlebarsApplicationMixin のパート制約） }}
<div class="em-npc">
<header class="em-npc__header">
  <img class="em-npc__avatar" src="{{document.img}}" data-edit="img" alt="" />
  {{#if isPlay}}
    <h1 class="em-npc__name">{{document.name}}</h1>
  {{else}}
    <input class="em-npc__name-input" type="text" name="name" value="{{document.name}}"
      placeholder="{{localize "DOCUMENT.FIELDS.name.label"}}" />
  {{/if}}

  {{! 現在値は卓中に減っていくものなので、モードによらず入力にする（共鳴者のメータと同じ）。
      最大値は能力値からの派生なので、どちらのモードでも表示だけ — 変えたいなら能力値を変える }}
  <div class="em-npc__resources">
    <label class="em-npc__resource"
      data-tooltip="{{localize "EMOKLORE.Actor.character.FIELDS.resources.hp.label"}}">
      {{! HP/MPのアイコンは共鳴者のメータと同じものを使う（fa-heart / fa-wand-magic-sparkles） }}
      <i class="fa-solid fa-heart em-npc__resource-icon" inert></i>
      <span class="em-npc__resource-edit">
        {{formInput systemFields.resources.fields.hp.fields.value value=system.resources.hp.value}}
        <span class="em-npc__resource-sep">/</span>
        <span>{{system.resources.hp.max}}</span>
      </span>
    </label>
    <label class="em-npc__resource"
      data-tooltip="{{localize "EMOKLORE.Actor.character.FIELDS.resources.mp.label"}}">
      <i class="fa-solid fa-wand-magic-sparkles em-npc__resource-icon" inert></i>
      <span class="em-npc__resource-edit">
        {{formInput systemFields.resources.fields.mp.fields.value value=system.resources.mp.value}}
        <span class="em-npc__resource-sep">/</span>
        <span>{{system.resources.mp.max}}</span>
      </span>
    </label>
  </div>
</header>

<section class="em-npc__characteristics">
  {{#each characteristics}}
    <div class="em-npc__characteristic">
      {{! CONFIG が持つのは字形のクラスだけ。書体（fa-solid）は使う側が足す }}
      <i class="fa-solid {{icon}}" inert></i>
      <span class="em-npc__characteristic-label">{{label}}</span>
      {{#if ../isPlay}}
        <span class="em-npc__characteristic-value">{{value}}</span>
      {{else}}
        {{! min / max はスキーマから来る。type を渡さないと、段階が決まる数値は
            本体が range-picker にする（NumberField#_toInput） }}
        {{formInput field value=value type="number"}}
      {{/if}}
    </div>
  {{/each}}
</section>

<section class="em-npc__skills">
  <h3>{{localize "EMOKLORE.Sheet.npc.Skills"}}</h3>
  <ul class="em-npc__skill-list">
    {{#each skills}}
      <li class="em-npc__skill">
        <a class="em-npc__skill-name" data-action="roll" data-roll-type="{{rollType}}" data-skill="{{key}}">{{markedLabel}}</a>
        <i class="fa-solid {{characteristicIcon}}" inert></i>
        {{#if ../isPlay}}
          <span class="em-npc__skill-level">{{localize "EMOKLORE.Format.level" level=level}}</span>
        {{else}}
          {{formInput field value=level type="number" classes="em-npc__skill-input"}}
        {{/if}}
        <span class="em-npc__skill-target">{{target}}</span>
      </li>
    {{/each}}
  </ul>
</section>

{{! 基本技能。閲覧モードには選ばれたものだけをチップで並べ、1つも無ければ欄ごと出さない。
    編集モードは選ぶ場所なので、空でも13件すべてを行で出す }}
{{#if (or baseSkills.length (not isPlay))}}
<section class="em-npc__skills">
  <h3>{{localize "EMOKLORE.Sheet.npc.BaseSkills"}}</h3>
  {{#if isPlay}}
    <div class="em-chip-list">
      {{#each baseSkills}}
        <button
          type="button"
          class="em-chip"
          data-action="roll"
          data-roll-type="{{rollType}}"
          data-skill="{{key}}"
        >
          <span class="em-chip__name">{{markedLabel}}</span>
          <span class="em-target">{{target}}</span>
          <i class="em-chip__icon fa-solid {{characteristicIcon}}"></i>
        </button>
      {{/each}}
    </div>
  {{else}}
    <ul class="em-npc__skill-list">
      {{#each baseSkills}}
        <li class="em-npc__skill em-npc__skill--base">
          {{! name を持たないチェックボックス。SetField へは toggleBaseSkill が直接書く }}
          <input
            type="checkbox"
            class="em-npc__skill-shown"
            data-action="toggleBaseSkill"
            data-skill="{{key}}"
            data-tooltip="EMOKLORE.Sheet.npc.ShowBaseSkill"
            {{checked shown}}
          />
          <a class="em-npc__skill-name" data-action="roll" data-roll-type="{{rollType}}" data-skill="{{key}}">{{markedLabel}}</a>
          <i class="fa-solid {{characteristicIcon}}" inert></i>
          <span class="em-npc__skill-target">{{target}}</span>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</section>
{{/if}}

{{#if customSkills.length}}
  <section class="em-npc__skills">
    <h3>{{localize "EMOKLORE.Sheet.npc.CustomSkills"}}</h3>
    <ul class="em-npc__skill-list">
      {{#each customSkills}}
        <li class="em-npc__skill" data-item-id="{{id}}">
          <a class="em-npc__skill-name" data-action="roll" data-roll-type="custom-skill" data-item-id="{{id}}">{{markedLabel}}</a>
          {{#if ../isPlay}}
            <span class="em-npc__skill-level">{{localize "EMOKLORE.Format.level" level=level}}</span>
          {{/if}}
          <span class="em-npc__skill-target">{{target}}</span>
        </li>
      {{/each}}
    </ul>
  </section>
{{/if}}

<section class="em-npc__weapons">
  <header class="em-npc__section-head">
    <h3>{{localize "EMOKLORE.Sheet.npc.Weapons"}}</h3>
    {{#unless isPlay}}
      <button type="button" data-action="createDoc" data-document-class="Item" data-type="weapon">
        <i class="fa-solid fa-plus" inert></i>
      </button>
    {{/unless}}
  </header>
  <ul class="em-npc__weapon-list">
    {{! data-document-class は行の右クリックメニューが引くための目印（actor-sheet.ts） }}
    {{#each weapons}}
      <li class="em-npc__weapon" data-item-id="{{id}}" data-document-class="Item">
        <img class="em-npc__weapon-image" src="{{img}}" height="24" width="24" alt="" />
        <a class="em-npc__weapon-name" data-action="roll" data-roll-type="weapon" data-item-id="{{id}}">{{name}}</a>
        <span class="em-npc__weapon-meta">{{rangeLabel}} / {{damagePreview}}</span>
        {{#unless ../isPlay}}
          <a data-action="viewDoc" data-tooltip="APPLICATION.ACTIONS.Edit"><i class="fa-solid fa-pen-to-square" inert></i></a>
          <a data-action="deleteDoc" data-tooltip="APPLICATION.ACTIONS.Delete"><i class="fa-solid fa-trash" inert></i></a>
        {{/unless}}
      </li>
    {{/each}}
  </ul>
</section>
</div>
