{{! Sheet Header }}
<header class="sheet-header em-sheet-header">
  {{! 閲覧は切り詰めるので、全文はツールチップで見せる }}
  {{#if isPlay}}
  <div class="em-sheet-header__name" data-tooltip="{{source.name}}">{{source.name}}</div>
  {{else}}
  <div class="em-sheet-header__name">
    {{formInput fields.name value=source.name placeholder=(localize "DOCUMENT.FIELDS.name.label")
    aria=(object label=(localize "DOCUMENT.FIELDS.name.label"))}}
  </div>
  {{/if}}

  {{#if isPlay}}
  <div class="em-resources">
    {{> "systems/emoklore/templates/actor/partials/meter.hbs"
      key="hp"
      icon="fa-heart"
      field=systemFields.resources.fields.hp.fields.value
      value=system.resources.hp.value
      max=system.resources.hp.max}}

    {{> "systems/emoklore/templates/actor/partials/meter.hbs"
      key="mp"
      icon="fa-wand-magic-sparkles"
      field=systemFields.resources.fields.mp.fields.value
      value=system.resources.mp.value
      max=system.resources.mp.max}}

    {{! 共鳴は感情3行を抱えていて他の2つと構成が違うので、partialにはしない }}
    <div class="em-meter em-meter--resonance">
      <div class="em-meter__head">
        <button
          type="button"
          class="inline-control icon em-meter__action fa-solid fa-infinity"
          data-action="roll"
          data-roll-type="resonance"
        ></button>
        <div class="em-meter__value">
          Lv.{{formInput systemFields.resources.fields.resonance.fields.value value=system.resources.resonance.value}}
        </div>
        {{! 表・裏・根源は「感情名: 属性」の対なので定義リストで表す }}
        <dl class="em-meter__emotions">
          <dt>{{emotionRows.surface.label}}</dt>
          <dd>{{#if emotionRows.surface.attribute}}（{{emotionRows.surface.attribute}}）{{/if}}</dd>
          <dt>{{emotionRows.hidden.label}}</dt>
          <dd>{{#if emotionRows.hidden.attribute}}（{{emotionRows.hidden.attribute}}）{{/if}}</dd>
          <dt>{{emotionRows.root.label}}</dt>
          <dd>{{#if emotionRows.root.attribute}}（{{emotionRows.root.attribute}}）{{/if}}</dd>
        </dl>
      </div>
      <progress
        class="em-progress em-progress--resonance"
        id="character-resonance"
        value="{{ system.resources.resonance.value }}"
        max="{{ system.resources.resonance.max }}"
      ></progress>
    </div>
  </div>
  {{else}}
  <div class="em-emotion-list">
    {{formGroup
    systemFields.emotions.fields.surface
    value=system.emotions.surface
    options=emotionOptions
    }}
    {{formGroup
    systemFields.emotions.fields.hidden
    value=system.emotions.hidden
    options=emotionOptions
    }}
    {{formGroup
    systemFields.emotions.fields.root
    value=system.emotions.root
    options=emotionOptions
    }}
  </div>
  {{/if}}
</header>
