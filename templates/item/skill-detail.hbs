{{! Skill Detail }}
<section class="em-item-detail">
  {{#if isPlay}}
    {{! ラベルは LOCALIZATION_PREFIXES 経由で本体が翻訳済みにしている }}
    <div class="em-field-list">
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.category.label display=categoryLabel inline=true}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.characteristicOptions.label display=characteristicLabel inline=true}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.group.label display=groupLabel inline=true}}
      {{#if showLevel}}
        {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.level.label display=(localize "EMOKLORE.Format.level" level=system.level) inline=true}}
      {{/if}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.notes.label display=notesHTML html=true}}
    </div>
  {{else}}
    {{! choices にはi18nキーが入っているので、描画時に本体へ解決させる。
        グループは blank を許すので、空欄の見出しだけこちらで名前を付ける }}
    {{formGroup systemFields.category value=system.category localize=true}}
    {{formGroup systemFields.characteristicOptions value=system.characteristicOptions localize=true}}
    {{formGroup systemFields.group value=system.group localize=true
      blank=(localize "EMOKLORE.Common.none")}}
    {{#if showLevel}}
      {{formGroup systemFields.level value=system.level}}
    {{/if}}
    {{formGroup systemFields.notes value=system.notes}}
  {{/if}}
</section>
