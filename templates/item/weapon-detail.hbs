{{! Weapon Detail }}
<section class="em-item-detail">
  {{#if isPlay}}
    {{! ラベルは LOCALIZATION_PREFIXES 経由で本体が翻訳済みにしている。
        間合いとダメージ式はスキーマに無い派生値なので、キーを直接引く }}
    <div class="em-field-list">
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.skill.label display=attackSkillLabel inline=true}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=(localize "EMOKLORE.Item.weapon.RangeType.Label") display=rangeTypeLabel inline=true}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=(localize "EMOKLORE.Item.weapon.Damage") display=damagePreview inline=true}}
      {{#if showRange}}
        {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.range.label display=system.range inline=true}}
      {{/if}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.notes.label display=notesHTML html=true}}
    </div>
  {{else}}
    {{! choices にはi18nキーが入っているので、描画時に本体へ解決させる }}
    {{formGroup systemFields.skill value=system.skill localize=true}}
    {{formGroup systemFields.attackPower value=system.attackPower}}
    {{formGroup systemFields.range value=system.range}}
    {{formGroup systemFields.equipped value=system.equipped}}
    {{formGroup systemFields.notes value=system.notes}}
  {{/if}}
</section>
