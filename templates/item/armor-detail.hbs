{{! Armor Detail }}
<section class="em-item-detail">
  {{#if isPlay}}
    {{! ラベルは LOCALIZATION_PREFIXES 経由で本体が翻訳済みにしている }}
    <div class="em-field-list">
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.defense.label display=system.defense inline=true}}
      {{#if showCoverage}}
        {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.coverage.label display=system.coverage inline=true}}
      {{/if}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.notes.label display=notesHTML html=true}}
    </div>
  {{else}}
    {{formGroup systemFields.defense value=system.defense}}
    {{formGroup systemFields.coverage value=system.coverage}}
    {{formGroup systemFields.equipped value=system.equipped}}
    {{formGroup systemFields.notes value=system.notes}}
  {{/if}}
</section>
