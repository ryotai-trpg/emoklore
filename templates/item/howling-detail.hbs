{{! Howling Detail }}
<section class="em-item-detail">
  {{#if isPlay}}
    {{! ラベルは LOCALIZATION_PREFIXES 経由で本体が翻訳済みにしている }}
    <div class="em-field-list">
      <div class="em-field em-field--inline">
        <label class="em-field__label">{{systemFields.category.label}}</label>
        <span class="em-field__value">{{categoryLabel}}</span>
      </div>
      <div class="em-field">
        <label class="em-field__label">{{systemFields.effect.label}}</label>
        <span class="em-field__value">{{{effectHTML}}}</span>
      </div>
      {{! 回復条件は文と技能の2本立て。どちらも任意なので、書かれているぶんだけ出す }}
      {{#if system.recovery.note}}
        <div class="em-field">
          <label class="em-field__label">{{systemFields.recovery.fields.note.label}}</label>
          <span class="em-field__value">{{system.recovery.note}}</span>
        </div>
      {{/if}}
      {{#if recoverySkillLabel}}
        <div class="em-field em-field--inline">
          <label class="em-field__label">{{systemFields.recovery.fields.skills.label}}</label>
          <span class="em-field__value">{{recoverySkillLabel}}</span>
        </div>
      {{/if}}
      <div class="em-field">
        <label class="em-field__label">{{systemFields.notes.label}}</label>
        <span class="em-field__value">{{{notesHTML}}}</span>
      </div>
    </div>
  {{else}}
    {{! choices にはi18nキーが入っているので、描画時に本体へ解決させる。
        回復判定の技能は choices 付きの SetField なので、本体が複数選択にしてくれる }}
    {{formGroup systemFields.category value=system.category localize=true}}
    {{formGroup systemFields.effect value=system.effect}}
    {{formGroup systemFields.recovery.fields.note value=system.recovery.note}}
    {{formGroup systemFields.recovery.fields.skills value=system.recovery.skills localize=true}}
    {{formGroup systemFields.notes value=system.notes}}
  {{/if}}
</section>
