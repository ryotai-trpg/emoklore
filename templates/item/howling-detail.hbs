{{! Howling Detail }}
<section class="em-item-detail">
  {{#if isPlay}}
    {{! ラベルは LOCALIZATION_PREFIXES 経由で本体が翻訳済みにしている }}
    <div class="em-field-list">
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.category.label display=categoryLabel inline=true}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.effect.label display=effectHTML html=true}}
      {{! 回復条件は文と技能の2本立て。どちらも任意なので、書かれているぶんだけ出す }}
      {{#if system.recovery.note}}
        {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.recovery.fields.note.label display=system.recovery.note}}
      {{/if}}
      {{#if recoverySkillLabel}}
        {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.recovery.fields.skills.label display=recoverySkillLabel inline=true}}
      {{/if}}
      {{> "systems/emoklore/templates/partials/field.hbs" label=systemFields.notes.label display=notesHTML html=true}}
    </div>
  {{else}}
    {{! choices にはi18nキーが入っているので、描画時に本体へ解決させる。
        回復判定の技能は choices 付きの SetField なので、本体が複数選択にしてくれる }}
    {{formGroup systemFields.category value=system.category localize=true}}
    {{formGroup systemFields.effect value=system.effect}}
    {{formGroup systemFields.recovery.fields.note value=system.recovery.note}}
    {{formGroup systemFields.recovery.fields.skills value=system.recovery.skills localize=true}}
    {{formGroup systemFields.notes value=system.notes}}
  {{/if}}
</section>
